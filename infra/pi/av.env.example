# Copied to /etc/teleop/av.env on the Pi. Tune on real hardware.

VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FPS=30
VIDEO_BITRATE=1500000

# Set to 0 for video-only (recommended until the I2S mic is confirmed).
AUDIO_ENABLED=0
# Example after `arecord -l`: plughw:1,0
AUDIO_DEVICE=plughw:1,0

RTSP_URL=rtsp://127.0.0.1:8554/robot
