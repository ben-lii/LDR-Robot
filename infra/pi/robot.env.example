# Copy to /etc/teleop/robot.env on the Pi. Never commit real values.
# See docs/PI_SETUP.md and robot/.env.example for field notes.

ROBOT_ID=00000000-0000-4000-8000-000000000001
TOKEN_PUBLIC_JWK={"kty":"EC","crv":"P-256","x":"...","y":"..."}

# Comma-separated browser origins (Vercel + local dev if needed)
ALLOWED_ORIGINS=https://your-app.vercel.app

PORT=8080
BIND=127.0.0.1
MAX_WS_CLIENTS=4

MOTOR_DRIVER=pigpio

PIN_AIN1=5
PIN_AIN2=6
PIN_BIN1=13
PIN_BIN2=26
# PIN_SLEEP=

INVERT_LEFT=false
INVERT_RIGHT=false
SWAP_MOTORS=false
PWM_FREQUENCY_HZ=1000
MIN_DRIVE_DUTY=0.25
RAMP_MS=250
MAX_SPEED_PERCENT=100
WATCHDOG_MS=300

MEDIA_MODE=mediamtx
MEDIAMTX_WHEP_URL=http://127.0.0.1:8889
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIA_PATH=robot
MAX_VIDEO_VIEWERS=2

LOG_LEVEL=info
