# Copy to robot/.env for local mock runs, or /etc/teleop/robot.env on the Pi.
# Never commit real values.

# From: npm run secrets:generate — must equal the "id" in web ROBOTS_JSON
ROBOT_ID=00000000-0000-4000-8000-000000000001

# From: npm run secrets:generate (public key only)
TOKEN_PUBLIC_JWK={"kty":"EC","crv":"P-256","x":"...","y":"..."}

# Comma-separated browser origins allowed for WS/CORS
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

PORT=8080
BIND=127.0.0.1
MAX_WS_CLIENTS=4

# mock on a laptop; pigpio on the Pi
MOTOR_DRIVER=mock

# BCM pin numbers (defaults — verify against your wiring in docs/HARDWARE.md)
PIN_AIN1=5
PIN_AIN2=6
PIN_BIN1=13
PIN_BIN2=26
# PIN_SLEEP=

INVERT_LEFT=false
INVERT_RIGHT=false
SWAP_MOTORS=false
PWM_FREQUENCY_HZ=1000
MIN_DRIVE_DUTY=0.25
RAMP_MS=250
MAX_SPEED_PERCENT=100
WATCHDOG_MS=300

# disabled = no camera (laptop); mediamtx on the Pi
MEDIA_MODE=disabled
MEDIAMTX_WHEP_URL=http://127.0.0.1:8889
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIA_PATH=robot
MAX_VIDEO_VIEWERS=2

LOG_LEVEL=info