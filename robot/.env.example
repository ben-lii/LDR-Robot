# Robot identity (from npm run robot:create)
ROBOT_ID=00000000-0000-0000-0000-000000000000
ROBOT_SECRET=replace-with-printed-secret

# Control plane (Vercel app URL)
CONTROL_PLANE_URL=https://your-app.vercel.app

# Public ES256 JWK (single-line JSON from npm run keys:generate)
TOKEN_PUBLIC_JWK={"kty":"EC","crv":"P-256","x":"...","y":"..."}

# Comma-separated browser origins allowed to connect
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

PORT=8080
BIND=127.0.0.1
MAX_WS_CLIENTS=4

# mock on a laptop; pigpio on the Pi
MOTOR_DRIVER=mock

# BCM pin numbers (defaults — verify against wiring)
PIN_AIN1=5
PIN_AIN2=6
PIN_BIN1=13
PIN_BIN2=26
# PIN_SLEEP=

INVERT_LEFT=false
INVERT_RIGHT=false
SWAP_MOTORS=false
PWM_FREQUENCY_HZ=1000
MIN_DRIVE_DUTY=0.25
RAMP_MS=250
MAX_SPEED_PERCENT=100
WATCHDOG_MS=300

# disabled = no camera (laptop); mediamtx on the Pi
MEDIA_MODE=disabled
MEDIAMTX_WHEP_URL=http://127.0.0.1:8889
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIA_PATH=robot
MAX_VIDEO_VIEWERS=2

LOG_LEVEL=info
